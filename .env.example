# ============================================================
# 智投罗盘 · 环境变量样例
# 本地开发可直接复制为 .env 或直接 export；云服务器务必用环境变量注入密钥，不要提交 apikey 文件。
# ============================================================

# 服务监听（本地默认 127.0.0.1，云端改为 0.0.0.0）
HOST=0.0.0.0
PORT=8710

# 火山引擎方舟大模型
ARK_API_KEY=在此填入你的方舟APIKey
ARK_MODEL=doubao-seed-evolving
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT=180

# 缓存与出网
ZHITOU_TTL_QUOTE=10
ZHITOU_TTL_KLINE=120
ZHITOU_TTL_MARKET=30
ZHITOU_HTTP_TIMEOUT=15
ZHITOU_HTTP_RETRY=2
# ZHITOU_PROXY=http://127.0.0.1:7890
